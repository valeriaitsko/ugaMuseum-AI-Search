# Lexical-only build of the search backend -- NO torch / sentence-transformers, so
# the image and its memory footprint fit a 512 MB free tier (e.g. Render free). The
# app falls back to whole-word matching over the enriched text automatically; every
# other feature is identical. For the full semantic search, use ./Dockerfile.

FROM python:3.12-slim

WORKDIR /app

COPY requirements-lexical.txt .
RUN pip install --no-cache-dir -r requirements-lexical.txt

COPY app ./app
# vectors.npz is never loaded without the encoder -- drop it so the image doesn't
# carry ~49 MB it can't use.
RUN rm -f app/data/vectors.npz

# Default port 7860 (Hugging Face); Render/Railway inject their own $PORT.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}"]
