# Claude API. Get a key at https://console.anthropic.com/settings/keys
# The account needs a positive credit balance -- the Free tier sets rate limits,
# not free usage.
ANTHROPIC_API_KEY=sk-ant-...

# Specify7 sync (app/specify_sync.py). Only needed once you connect real data;
# leave blank to run on the built-in demo specimens.
SPECIFY_BASE_URL=https://your-specify-host.example.org
SPECIFY_COLLECTION_ID=

# Auth -- use whichever your Specify7 instance supports (see app/specify_sync.py).
# API key, if your instance issues them:
SPECIFY_API_KEY=
# ...or session login:
SPECIFY_USERNAME=
SPECIFY_PASSWORD=

# Specify DB snapshot (app/build_snapshot.py). Reads the MySQL/MariaDB that backs
# Specify DIRECTLY -- not the REST API. Point these at the same database Specify
# uses (see Specify's local_specify_settings.py for the values it connects with).
SPECIFY_DB_HOST=127.0.0.1
SPECIFY_DB_PORT=3306
SPECIFY_DB_NAME=SpecifyDB
SPECIFY_DB_USER=
SPECIFY_DB_PASSWORD=
